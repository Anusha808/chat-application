<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatapp.controller.RegisterController"
      alignment="CENTER"
      spacing="15"
      prefWidth="400"
      prefHeight="600"
      styleClass="register-container">

    <padding>
        <Insets top="40"
                right="40"
                bottom="40"
                left="40"/>
    </padding>

    <Label text="CREATE ACCOUNT"
           styleClass="title-label"/>

    <Label text="Join Chat Application"
           styleClass="subtitle-label"/>

    <TextField fx:id="usernameField"
               promptText="Username"
               maxWidth="280"
               styleClass="input-field"/>

    <TextField fx:id="emailField"
               promptText="Email"
               maxWidth="280"
               styleClass="input-field"/>

    <PasswordField fx:id="passwordField"
                   promptText="Password"
                   maxWidth="280"
                   styleClass="input-field"/>

    <PasswordField fx:id="confirmPasswordField"
                   promptText="Confirm Password"
                   maxWidth="280"
                   styleClass="input-field"/>

    <Button text="REGISTER"
            onAction="#handleRegister"
            prefWidth="280"
            styleClass="register-button"/>

    <Label fx:id="messageLabel"
           text=""
           wrapText="true"
           maxWidth="280"
           styleClass="message-label"/>

    <Label text="Already have an account? Login"
           styleClass="login-label"/>

</VBox>