<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.chatapp.controller.ProfileController"
        style="-fx-background-color: #FAF9FF;">

    <!-- TOP BAR -->
    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="15"
                style="-fx-background-color: #FFFFFF;
                       -fx-border-color: #E8E3F0;
                       -fx-border-width: 0 0 1 0;
                       -fx-padding: 18 25 18 25;">

            <Button
                    fx:id="backButton"
                    text="‹"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8B72BE;
                           -fx-font-size: 28px;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"
                    prefWidth="45"
                    prefHeight="40"/>

            <Label
                    text="My Profile"
                    style="-fx-text-fill: #302B3D;
                           -fx-font-size: 22px;
                           -fx-font-weight: bold;"/>

        </HBox>

    </top>


    <!-- PROFILE CONTENT -->
    <center>

        <VBox
                alignment="TOP_CENTER"
                spacing="20"
                maxWidth="650"
                style="-fx-background-color: #FFFFFF;
                       -fx-background-radius: 18;
                       -fx-border-color: #E8E3F0;
                       -fx-border-radius: 18;
                       -fx-padding: 35;">

            <BorderPane.margin>
                <Insets
                        top="35"
                        right="35"
                        bottom="35"
                        left="35"/>
            </BorderPane.margin>


            <!-- PROFILE AVATAR -->

            <StackPane
                    xmlns="http://javafx.com/javafx/17"
                    alignment="CENTER">

                <Circle
                        radius="55"
                        fill="#B8A7D9"/>

                <Label
                        fx:id="avatarLabel"
                        text="A"
                        style="-fx-text-fill: #FFFFFF;
                               -fx-font-size: 40px;
                               -fx-font-weight: bold;"/>

            </StackPane>


            <!-- USERNAME -->

            <Label
                    fx:id="usernameLabel"
                    text="Username"
                    style="-fx-text-fill: #302B3D;
                           -fx-font-size: 24px;
                           -fx-font-weight: bold;"/>


            <!-- ONLINE STATUS -->

            <HBox
                    alignment="CENTER"
                    spacing="8">

                <Circle
                        radius="6"
                        fill="#55A66B"/>

                <Label
                        text="Online"
                        style="-fx-text-fill: #55A66B;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;"/>

            </HBox>


            <!-- INFORMATION -->

            <VBox
                    spacing="12"
                    maxWidth="500">

                <Label
                        text="Username"
                        style="-fx-text-fill: #777184;
                               -fx-font-size: 13px;"/>

                <TextField
                        fx:id="usernameField"
                        editable="false"
                        style="-fx-background-color: #FAF9FF;
                               -fx-border-color: #E8E3F0;
                               -fx-border-radius: 8;
                               -fx-background-radius: 8;
                               -fx-padding: 11;
                               -fx-text-fill: #302B3D;
                               -fx-font-size: 14px;"/>


                <Label
                        text="Email"
                        style="-fx-text-fill: #777184;
                               -fx-font-size: 13px;"/>

                <TextField
                        fx:id="emailField"
                        editable="false"
                        style="-fx-background-color: #FAF9FF;
                               -fx-border-color: #E8E3F0;
                               -fx-border-radius: 8;
                               -fx-background-radius: 8;
                               -fx-padding: 11;
                               -fx-text-fill: #302B3D;
                               -fx-font-size: 14px;"/>

            </VBox>


            <!-- BUTTONS -->

            <HBox
                    alignment="CENTER"
                    spacing="12"
                    padding="10 0 0 0">

                <Button
                        fx:id="editProfileButton"
                        text="Edit Profile"
                        prefWidth="150"
                        prefHeight="42"
                        style="-fx-background-color: #8B72BE;
                               -fx-text-fill: #FFFFFF;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 9;
                               -fx-cursor: hand;"/>

                <Button
                        fx:id="changePasswordButton"
                        text="Change Password"
                        prefWidth="170"
                        prefHeight="42"
                        style="-fx-background-color: #B8A7D9;
                               -fx-text-fill: #302B3D;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 9;
                               -fx-cursor: hand;"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>