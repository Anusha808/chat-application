<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatapp.controller.ChatController"
            prefWidth="1100"
            prefHeight="700"
            styleClass="chat-container">


    <!-- =====================================================
         TOP HEADER
         ===================================================== -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="chat-header">

            <padding>
                <Insets top="14"
                        right="22"
                        bottom="14"
                        left="22"/>
            </padding>


            <!-- LOGO -->

            <VBox spacing="2"
                  styleClass="brand-area">

                <Label text="💬"
                       styleClass="brand-icon"/>

            </VBox>


            <!-- TITLE -->

            <VBox spacing="2">

                <Label text="Chat Application"
                       styleClass="header-title"/>

                <Label text="Stay connected. Stay together."
                       styleClass="header-subtitle"/>

            </VBox>


            <!-- SPACER -->

            <HBox HBox.hgrow="ALWAYS"/>


            <!-- WELCOME -->

            <Label fx:id="welcomeLabel"
                   text="Welcome!"
                   styleClass="welcome-label"/>


            <!-- PROFILE -->

            <Button text="PROFILE"
                    onAction="#handleProfile"
                    styleClass="header-button"/>


            <!-- SETTINGS -->

            <Button text="⚙ SETTINGS"
                    onAction="#handleSettings"
                    styleClass="header-button"/>


            <!-- LOGOUT -->

            <Button text="LOGOUT"
                    onAction="#handleLogout"
                    styleClass="logout-button"/>

        </HBox>

    </top>


    <!-- =====================================================
         LEFT SIDEBAR
         ===================================================== -->

    <left>

        <VBox prefWidth="270"
              spacing="14"
              styleClass="sidebar">

            <padding>
                <Insets top="22"
                        right="18"
                        bottom="22"
                        left="18"/>
            </padding>


            <!-- =================================================
                 PRIVATE MESSAGES / PEOPLE
                 ================================================= -->

            <VBox spacing="10"
                  VBox.vgrow="ALWAYS"
                  styleClass="sidebar-section">


                <!-- PEOPLE HEADER -->

                <HBox alignment="CENTER_LEFT"
                      spacing="8">

                    <Label text="PEOPLE"
                           styleClass="section-title"/>

                    <Label text="●"
                           styleClass="section-dot"/>

                </HBox>


                <!-- PEOPLE SEARCH -->

                <HBox alignment="CENTER_LEFT"
                      spacing="5"
                      styleClass="search-box">

                    <TextField fx:id="searchField"
                               promptText="🔍  Search people..."
                               HBox.hgrow="ALWAYS"
                               styleClass="search-field"/>

                    <Button fx:id="clearSearchButton"
                            text="✕"
                            onAction="#handleClearSearch"
                            styleClass="clear-search-button"/>

                </HBox>


                <!-- PRIVATE MESSAGE LIST -->

                <ListView fx:id="userListView"
                          VBox.vgrow="ALWAYS"
                          styleClass="user-list"/>

            </VBox>


            <!-- =================================================
                 GROUP SECTION
                 ================================================= -->

            <VBox spacing="10"
                  styleClass="group-section">


                <!-- GROUP HEADER -->

                <HBox alignment="CENTER_LEFT"
                      spacing="10">

                    <Label text="GROUPS"
                           styleClass="section-title"
                           HBox.hgrow="ALWAYS"/>


                    <!-- CREATE GROUP -->

                    <Button text="+"
                            onAction="#handleCreateGroup"
                            styleClass="create-group-button"
                            prefWidth="34"
                            prefHeight="34"/>

                </HBox>


                <!-- GROUP SEARCH -->

                <HBox alignment="CENTER_LEFT"
                      spacing="5"
                      styleClass="group-search-box">

                    <TextField fx:id="groupSearchField"
                               promptText="🔍  Search groups..."
                               HBox.hgrow="ALWAYS"
                               styleClass="group-search-field"/>

                    <Button fx:id="clearGroupSearchButton"
                            text="✕"
                            onAction="#handleClearGroupSearch"
                            styleClass="clear-group-search-button"/>

                </HBox>


                <!-- GROUP LIST -->

                <ListView fx:id="groupListView"
                          prefHeight="160"
                          minHeight="100"
                          styleClass="group-list"/>

            </VBox>

        </VBox>

    </left>


    <!-- =====================================================
         CENTER CHAT AREA
         ===================================================== -->

    <center>

        <BorderPane styleClass="conversation-container">


            <!-- =================================================
                 CHAT HEADER
                 ================================================= -->

            <top>

                <HBox alignment="CENTER_LEFT"
                      spacing="12"
                      styleClass="conversation-header">

                    <padding>
                        <Insets top="15"
                                right="22"
                                bottom="15"
                                left="22"/>
                    </padding>


                    <!-- CHAT AVATAR -->

                    <Label text="💬"
                           styleClass="conversation-icon"/>


                    <!-- CHAT TITLE -->

                    <VBox spacing="3">

                        <Label fx:id="chatTitleLabel"
                               text="Select a user to start chatting"
                               styleClass="chat-title"/>

                        <Label text="Your conversations"
                               styleClass="chat-subtitle"/>

                    </VBox>


                    <!-- SPACER -->

                    <HBox HBox.hgrow="ALWAYS"/>


                    <!-- =================================================
                         MESSAGE SEARCH
                         ================================================= -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="5"
                          styleClass="message-search-box">

                        <TextField fx:id="messageSearchField"
                                   promptText="🔎  Search messages..."
                                   prefWidth="200"
                                   styleClass="message-search-field"/>

                        <Button fx:id="clearMessageSearchButton"
                                text="✕"
                                onAction="#handleClearMessageSearch"
                                styleClass="clear-message-search-button"/>

                    </HBox>


                    <!-- MEMBERS -->

                    <Button fx:id="membersButton"
                            text="MEMBERS"
                            onAction="#handleViewMembers"
                            visible="false"
                            managed="false"
                            styleClass="members-button"/>

                </HBox>

            </top>


            <!-- =================================================
                 MESSAGE AREA
                 ================================================= -->

            <center>

                <VBox styleClass="message-area">

                    <ListView fx:id="messageListView"
                              VBox.vgrow="ALWAYS"
                              styleClass="message-list"/>

                </VBox>

            </center>


            <!-- =================================================
                 MESSAGE INPUT
                 ================================================= -->

            <bottom>

                <HBox spacing="10"
                      alignment="CENTER"
                      styleClass="message-input-area">

                    <padding>
                        <Insets top="16"
                                right="20"
                                bottom="16"
                                left="20"/>
                    </padding>


                    <!-- ATTACHMENT BUTTON -->

                    <Button fx:id="attachmentButton"
                            text="📎"
                            onAction="#handleAttachment"
                            styleClass="icon-button"
                            prefWidth="42"
                            prefHeight="42"/>


                    <!-- EMOJI BUTTON -->

                    <Button fx:id="emojiButton"
                            text="😊"
                            onAction="#handleEmoji"
                            styleClass="icon-button"
                            prefWidth="42"
                            prefHeight="42"/>


                    <!-- MESSAGE FIELD -->

                    <TextField fx:id="messageField"
                               promptText="Write a message..."
                               HBox.hgrow="ALWAYS"
                               styleClass="message-field"/>


                    <!-- SEND BUTTON -->

                    <Button text="SEND  ➤"
                            onAction="#handleSendMessage"
                            styleClass="send-button"/>

                </HBox>

            </bottom>

        </BorderPane>

    </center>

</BorderPane>